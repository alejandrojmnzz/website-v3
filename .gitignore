node_modules
dist
.DS_Store
artifacts

# Site content folders — each site has its own repo (GITHUB_REPO_URL).
# The site_*/ glob covers every site folder; the platform code repo does not contain content.
site_*/
marketing-content/*
!marketing-content/.gitkeep
!marketing-content/README.md

# MCP server — generated OAuth client registry (contains secrets)
mcp-server/data/

# SQLite database file (local only — back up manually for production)
data/

# Conversation screenshots (not marketing content)
attached_assets/Screenshot_*
attached_assets/Captura_*
attached_assets/Capture_*
server/public
vite.config.ts.*
*.tar.gz

# Runtime state files (dot-prefixed in content folders: bucket in production, local-only in dev)
marketing-content/.*-state.json
marketing-content/.*-state.txt
**/.sync-log-state.txt

# Environment variables
.env
.env.local

# Log files
*.log

# Lighthouse / PSI report JSON files (keep .gitkeep, ignore dated report files)
reports/lighthouse/**/*.json

# IDE settings (uncomment if not sharing across team)
# .vscode/
# .idea/

# Cursor IDE settings (optional - uncomment if not sharing rules)
# Note: .cursor/rules/ should be committed if sharing team rules
# .cursor/.cache/

# Qdrant vector store — binary and storage data (local only)
.local/bin/qdrant
.cache/qdrant-storage/
